---
import '../styles/base.css';
import 'katex/dist/katex.min.css';
import { useTranslations, getUrlForLang, defaultLang } from '../i18n';
import { identity } from '../data/site';
import SiteNav from '../components/navigation/SiteNav.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'zh';
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  canonical?: string;
  /** Override the robots meta. Fallback article pages pass 'noindex, follow'. */
  robots?: string;
  /** Explicit hreflang alternates; when omitted the en/zh pair is derived. */
  altLangs?: Array<{ hreflang: string; href: string }>;
  /** Override the x-default URL (defaults to the site's default-language home). */
  xDefault?: string;
}

const {
  title,
  description,
  lang = 'en',
  image,
  type = 'website',
  publishedTime,
  canonical,
  robots = 'index, follow',
  altLangs,
  xDefault,
} = Astro.props;
const t = useTranslations(lang);
const siteTitle = title.toLowerCase().includes('kyrin') ? title : `${title} | kyrin.one`;
const siteDescription = description || t('seo.description');

const url = Astro.url;
const canonicalUrl = new URL(canonical || url.pathname, Astro.site).href;
const altLang = lang === 'en' ? 'zh' : 'en';
const alternates =
  altLangs && altLangs.length > 0
    ? altLangs
    : [
        { hreflang: lang, href: canonicalUrl },
        { hreflang: altLang, href: new URL(getUrlForLang(url, altLang), Astro.site).href },
      ];
const xDefaultUrl = new URL(xDefault || `/${defaultLang}/`, Astro.site).href;
const role = identity.role[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'kyrin.one',
      url: 'https://www.kyrin.one',
      description: t('seo.description'),
      inLanguage: lang,
      alternateName: 'Kyrin Labs',
    },
    {
      '@type': 'Person',
      name: 'Kyrin',
      url: 'https://www.kyrin.one/',
      jobTitle: role,
      description: identity.subline[lang],
      knowsAbout: ['digital investigation', 'data leak investigation', 'threat hunting', 'threat analysis'],
    },
  ],
};

// Escape sequences that could break out of the <script> context.
const jsonLdHtml = JSON.stringify(jsonLd)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <meta name="author" content="Kyrin" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0a100d" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="kyrin.one" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {image && <meta property="og:image" content={image} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    {image && <meta name="twitter:image" content={image} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={jsonLdHtml}></script>

    <title>{siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-bg text-text antialiased">
    <SiteNav lang={lang} />

    <main class="pt-12 min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="max-w-6xl mx-auto px-4 sm:px-5 py-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-5">
          <div class="flex items-center gap-3 font-mono text-xs text-faint">
            <a href={`/${lang}/`} class="brand-block text-text flex items-baseline gap-0.5 text-sm">
              <span>kyr</span><span class="brand-highlight">in</span><span class="text-faint">.one</span>
            </a>
            <span class="text-border">|</span>
            <span>&copy; {new Date().getFullYear()} Kyrin. {t('footer.copyright')}</span>
          </div>

          <div class="flex items-center gap-4 font-mono text-xs text-muted">
            <a href="https://github.com/freedalek" class="hover:text-accent-strong transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={`/${lang}/rss.xml`} class="hover:text-accent-strong transition-colors">RSS</a>
            <span class="text-border">|</span>
            <span>{t('footer.built')}</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
