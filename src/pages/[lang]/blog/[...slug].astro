---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { articleLocale } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const nonDraft = posts.filter(p => !p.data.draft);

  // Group by slug for cross-language fallback
  const postsBySlug = new Map<string, any[]>();
  for (const post of nonDraft) {
    const cleanSlug = post.id.replace(/\.(en|zh)$/, '');
    if (!postsBySlug.has(cleanSlug)) {
      postsBySlug.set(cleanSlug, []);
    }
    postsBySlug.get(cleanSlug)!.push(post);
  }

  // Generate paths for all languages, with fallback
  const paths: Array<{ params: { lang: string; slug: string }; props: { entry: any; fallback: boolean } }> = [];

  for (const [slug, entries] of postsBySlug) {
    const enEntry = entries.find(e => e.data.lang === 'en');
    const zhEntry = entries.find(e => e.data.lang === 'zh');

    if (enEntry) {
      paths.push({ params: { lang: 'en', slug }, props: { entry: enEntry, fallback: false } });
    } else if (zhEntry) {
      paths.push({ params: { lang: 'en', slug }, props: { entry: zhEntry, fallback: true } });
    }

    if (zhEntry) {
      paths.push({ params: { lang: 'zh', slug }, props: { entry: zhEntry, fallback: false } });
    } else if (enEntry) {
      paths.push({ params: { lang: 'zh', slug }, props: { entry: enEntry, fallback: true } });
    }
  }

  return paths;
}

const { entry, fallback } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const loc = articleLocale(entry, fallback, 'blog');
const readOther = loc.displayLang === 'en' ? 'Read in Chinese' : '阅读英文版';
---

<ArticleLayout
  title={data.title}
  description={data.description || ''}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  lang={loc.displayLang}
  langLink={data.langLink}
  tagBase={`/${loc.realLang}/knowledge/`}
  robots={loc.isFallback ? 'noindex, follow' : undefined}
  canonical={loc.isFallback ? loc.realPath : undefined}
  altLangs={loc.isFallback ? [{ hreflang: loc.realLang, href: loc.realPath }] : undefined}
  xDefault={loc.isFallback ? loc.realPath : undefined}
>
  {loc.isFallback && (
    <div slot="notice" class="mb-6 p-3 rounded-lg border border-amber/30 bg-amber/10 text-sm text-amber font-mono flex flex-wrap items-center gap-x-3 gap-y-1">
      <span>{loc.fallbackNote}</span>
      <a href={loc.realPath} class="underline hover:no-underline">{readOther} →</a>
    </div>
  )}
  <Content slot="content" />
</ArticleLayout>

