---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';
import { getDisplayEntries, toSearchItem, type CollectionName } from '../../lib/content';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } },
  ];
}

const { lang } = Astro.params as { lang: 'en' | 'zh' };
const t = useTranslations(lang);

// Build a static JSON index at build time for the current language.
const searchCollections: CollectionName[] = ['blog', 'notes', 'writeups', 'research', 'projects', 'stream', 'investigations', 'prompts'];
const index: Array<{ title: string; desc: string; tags: string[]; url: string; date: string; type: string }> = [];

for (const name of searchCollections) {
  const items = await getDisplayEntries(lang, name);
  for (const it of items) {
    // Search only indexes content written in the current language.
    if (it.isFallback) continue;
    const item = toSearchItem(lang, name, it.entry);
    if (!item.title) continue;
    index.push({ ...item, type: name });
  }
}

const typeLabels: Record<string, string> = {
  blog: t('type.essay'),
  notes: t('type.note'),
  writeups: t('type.writeup'),
  research: t('type.research'),
  projects: t('type.project'),
  stream: t('type.stream'),
  investigations: t('type.investigation'),
  prompts: t('type.prompt'),
};

const json = JSON.stringify(index).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
const labelsJson = JSON.stringify(typeLabels).replace(/</g, '\\u003c');
const noResultsText = lang === 'en' ? 'No results for' : '没有找到与';
const typePromptText = lang === 'en' ? 'Type to search…' : '输入以搜索…';
const resultsText = lang === 'en' ? 'results' : '条结果';
const i18nJson = JSON.stringify({
  noResults: noResultsText,
  typePrompt: typePromptText,
  results: resultsText,
}).replace(/</g, '\\u003c');
---

<BaseLayout title={t('nav.search')} lang={lang}>
  <div class="max-w-4xl mx-auto px-4 sm:px-5 py-12">
    <header class="mb-8">
      <nav class="term-line mb-4 flex items-center gap-2">
        <a href={`/${lang}/`} class="hover:text-accent transition-colors">~</a>
        <span class="text-border">/</span>
        <span class="text-accent">{t('nav.search')}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold font-display mb-4">{t('search.title')}</h1>
      <p class="text-muted font-mono text-sm">{t('search.prompt')}</p>
    </header>

    <!-- Search input -->
    <div class="mb-8">
      <label for="search-input" class="sr-only">{t('nav.search')}</label>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-accent font-mono" aria-hidden="true">$</span>
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder={t('search.placeholder')}
          class="w-full rounded-lg border border-border bg-surface/70 px-12 py-3 font-mono text-sm text-text placeholder:text-faint outline-none transition-colors focus:border-accent/60 focus:bg-surface"
        />
      </div>
      <div id="search-meta" class="mt-3 font-mono text-xs text-faint" role="status"></div>
    </div>

    <!-- Results -->
    <div id="search-results" class="space-y-3"></div>

    <!-- Build-time index -->
    <script type="application/json" id="search-index" is:inline set:html={json}></script>
    <script type="application/json" id="search-labels" is:inline set:html={labelsJson}></script>
    <script type="application/json" id="search-i18n" is:inline set:html={i18nJson}></script>

    <template id="search-empty">
      <div class="text-center py-12 font-mono text-sm text-muted">
        <p id="empty-text"></p>
      </div>
    </template>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results');
  const metaEl = document.getElementById('search-meta');
  if (!input || !resultsEl || !metaEl) throw new Error('search DOM missing');

  const raw = document.getElementById('search-index')?.textContent || '[]';
  const INDEX: Array<{ title: string; desc: string; tags: string[]; url: string; date: string; type: string }> =
    JSON.parse(raw);

  const TYPE_LABELS: Record<string, string> = JSON.parse(
    document.getElementById('search-labels')?.textContent || '{}'
  );

  const I18N = JSON.parse(document.getElementById('search-i18n')?.textContent || '{}');
  const MSG_NO_RESULTS: string = I18N.noResults || 'No results for';
  const MSG_TYPE: string = I18N.typePrompt || 'Type to search…';
  const MSG_RESULTS: string = I18N.results || 'results';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function highlight(text: string, q: string): string {
    if (!q) return esc(text);
    const lower = text.toLowerCase();
    const idx = lower.indexOf(q.toLowerCase());
    if (idx === -1) return esc(text);
    return (
      esc(text.slice(0, idx)) +
      '<mark class="bg-accent/25 text-accent-strong rounded-sm px-0.5">' +
      esc(text.slice(idx, idx + q.length)) +
      '</mark>' +
      esc(text.slice(idx + q.length))
    );
  }

  function render(items: typeof INDEX, query: string) {
    if (items.length === 0) {
      const emptyMsg = document.getElementById('empty-text');
      if (emptyMsg) emptyMsg.textContent = query ? `${MSG_NO_RESULTS} "${query}"` : MSG_TYPE;
      resultsEl!.innerHTML = (document.getElementById('search-empty') as HTMLTemplateElement).innerHTML;
      metaEl!.textContent = '';
      return;
    }
    resultsEl!.innerHTML = items
      .map(
        (it) => `
        <a href="${esc(it.url)}" class="article-card block no-underline">
          <div class="flex items-center justify-between gap-3 mb-1">
            <span class="font-mono text-[0.62rem] text-accent uppercase tracking-wider">${esc(TYPE_LABELS[it.type] || it.type)}</span>
            <span class="font-mono text-[0.62rem] text-faint">${esc(it.date)}</span>
          </div>
          <h3 class="font-semibold text-sm leading-snug">${highlight(it.title, query)}</h3>
          ${it.desc ? `<p class="text-xs text-muted line-clamp-2 mt-1.5 leading-relaxed">${highlight(it.desc, query)}</p>` : ''}
          ${it.tags.length ? `<div class="flex flex-wrap gap-1.5 mt-2">${it.tags.slice(0, 5).map((tag) => `<span class="tag-chip text-[10px]">#${esc(tag)}</span>`).join('')}</div>` : ''}
        </a>`
      )
      .join('');
    metaEl!.textContent = `${items.length} ${MSG_RESULTS}`;
  }

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (!q) {
      render([], '');
      return;
    }
    const matches = INDEX.filter((it) => {
      const haystack = `${it.title} ${it.desc} ${it.tags.join(' ')}`.toLowerCase();
      return haystack.includes(q);
    }).slice(0, 20);
    render(matches, input.value.trim());
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const first = resultsEl!.querySelector('a.article-card') as HTMLAnchorElement | null;
      if (first) window.location.href = first.getAttribute('href') || '/';
    }
  });

  render([], '');
</script>
